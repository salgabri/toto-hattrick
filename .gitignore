# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# env / secrets — NEVER commit these
.env
.env.*
!.env.example
# OAuth token stashes written by scripts/get-token.ts — secrets, NEVER commit
.oauth-*.json

# database
*.db
*.db-journal
*.sqlite
server/prisma/dev.db*

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# real CHPP XML captures may contain team data — keep only the curated samples you intend to commit
# (delete this rule if you want everything in /samples tracked)
server/samples/*.local.xml

# scrape scratch (regenerated by scripts/export-unresolved.ts)
web/public/targets.json

# in-browser scrape working dir: the targets/results JSONL the browser scripts read and append to
# (SCRAPE_DIR in server/.env). Machine-local and large; the DB is the durable copy.
.scrape/

# pre-bake snapshots of dev.db and web/public/data, kept so a bad bake can be rolled back.
# Tens of MB and purely local — the .db patterns above don't catch the timestamped copies.
.backup/
.claude/settings.local.json
.claude/launch.json

# generated unresolved-teams snapshot (re-run scripts/list-unresolved.ts)
unresolved-teams.csv
