// Hattrick Archive — data model.
// Starting point per spec; refine column shapes against real XML in /samples.
// Swap to Postgres later by changing `provider` + DATABASE_URL only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Hattrick team we sync. Bounds how far back to walk (foundedDate).
model Team {
  teamId      Int      @id
  name        String
  foundedDate DateTime?
  leagueId    Int?

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One match summary, sourced from `matchesarchive`.
/// `detailsFetched` flips true once `matchdetails` has enriched it.
model Match {
  matchId      Int      @id
  teamId       Int
  season       Int
  matchDate    DateTime
  homeTeamId   Int
  awayTeamId   Int
  homeTeamName String
  awayTeamName String
  homeGoals    Int?
  awayGoals    Int?
  matchType    Int?
  detailsFetched Boolean @default(false)

  team   Team         @relation(fields: [teamId], references: [teamId])
  detail MatchDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, season])
  @@index([matchDate])
}

/// Enriched detail from `matchdetails`. JSON columns now; normalize later only if a feature needs it.
model MatchDetail {
  matchId     Int    @id
  lineupJson  String // JSON: lineup / formation
  scorersJson String // JSON: goals + scorers
  ratingsJson String // JSON: player + team ratings

  match Match @relation(fields: [matchId], references: [matchId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The final league table for the division a team played in, one row per season. Reconstructed
/// from `leaguefixtures` (which serves historical seasons). `championTeam*` is the top of the
/// computed standings; `complete` is false while a season is still being played.
model SeasonStanding {
  teamId              Int
  season              Int
  leagueLevelUnitId   Int
  leagueLevelUnitName String
  championTeamId      Int
  championTeamName    String
  complete            Boolean @default(false)
  standingsJson       String // full table: StandingRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([teamId, season])
}

/// Seed of every Hattrick league's top division (level 1). topSeriesId is the
/// LeagueLevelUnitID used to reconstruct that country's champions via leaguefixtures.
model NationalLeague {
  leagueId      Int     @id
  countryName   String
  topSeriesId   Int
  currentSeason Int?
  isCountry     Boolean @default(true)

  champions LeagueChampion[]
}

/// Champion of a country's top division for one season. Reconstructed from leaguefixtures
/// (works for past seasons). championUserId is null for historical seasons — leaguefixtures
/// exposes team ids/names but not the manager. `complete` is false for the running season.
model LeagueChampion {
  leagueId         Int
  season           Int
  topSeriesId      Int
  countryName      String
  championTeamId   Int
  championTeamName String
  championUserId   Int?
  championUserName String?
  played           Int
  points           Int
  complete         Boolean @default(false)

  league NationalLeague @relation(fields: [leagueId], references: [leagueId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([leagueId, season])
  @@index([season])
  @@index([championTeamId])
  @@index([championUserId])
}

/// A Hattrick manager who has won at least one top-division title. Resolved from the champion
/// team's CURRENT owner (teamdetails) — historical owners aren't exposed by CHPP. nationality
/// comes from managercompendium. isBot/abandoned teams have no owner (userId stays unresolved).
model HattrickUser {
  userId      Int     @id
  loginName   String
  countryId   Int?
  nationality String? // manager's country (managercompendium)
  isBot       Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([nationality])
}

/// Per-user CHPP OAuth 1.0a access token + secret. Server-side only.
/// `userId` is Hattrick's user id (from the access-token response), not a local account.
model ChppToken {
  userId      Int      @id
  accessToken String
  tokenSecret String
  scope       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
