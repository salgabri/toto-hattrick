// Hattrick Archive — data model.
// Starting point per spec; refine column shapes against real XML in /samples.
// Swap to Postgres later by changing `provider` + DATABASE_URL only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Hattrick team we sync. Bounds how far back to walk (foundedDate).
model Team {
  teamId      Int      @id
  name        String
  foundedDate DateTime?
  leagueId    Int?

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One match summary, sourced from `matchesarchive`.
/// `detailsFetched` flips true once `matchdetails` has enriched it.
model Match {
  matchId      Int      @id
  teamId       Int
  season       Int
  matchDate    DateTime
  homeTeamId   Int
  awayTeamId   Int
  homeTeamName String
  awayTeamName String
  homeGoals    Int?
  awayGoals    Int?
  matchType    Int?
  detailsFetched Boolean @default(false)

  team   Team         @relation(fields: [teamId], references: [teamId])
  detail MatchDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, season])
  @@index([matchDate])
}

/// Enriched detail from `matchdetails`. JSON columns now; normalize later only if a feature needs it.
model MatchDetail {
  matchId     Int    @id
  lineupJson  String // JSON: lineup / formation
  scorersJson String // JSON: goals + scorers
  ratingsJson String // JSON: player + team ratings

  match Match @relation(fields: [matchId], references: [matchId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The final league table for the division a team played in, one row per season. Reconstructed
/// from `leaguefixtures` (which serves historical seasons). `championTeam*` is the top of the
/// computed standings; `complete` is false while a season is still being played.
model SeasonStanding {
  teamId              Int
  season              Int
  leagueLevelUnitId   Int
  leagueLevelUnitName String
  championTeamId      Int
  championTeamName    String
  complete            Boolean @default(false)
  standingsJson       String // full table: StandingRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([teamId, season])
}

/// Seed of every Hattrick league's top division (level 1). topSeriesId is the
/// LeagueLevelUnitID used to reconstruct that country's champions via leaguefixtures.
model NationalLeague {
  leagueId      Int     @id
  countryName   String
  topSeriesId   Int
  currentSeason Int?
  isCountry     Boolean @default(true)
  /// worlddetails' NationalTeamId/U20TeamId — the country's senior/youth NATIONAL team (distinct
  /// from any club team). Backfilled once (scripts/backfill-national-team-ids.ts) to cross-reference
  /// World Cup champion nations against their coaching history (sync/worldCup.ts attribution pass).
  nationalTeamId Int?
  u20TeamId      Int?

  champions LeagueChampion[]
}

/// Champion of a country's top division for one season. Reconstructed from leaguefixtures
/// (works for past seasons). championUserId is null for historical seasons — leaguefixtures
/// exposes team ids/names but not the manager. `complete` is false for the running season.
model LeagueChampion {
  leagueId         Int
  season           Int
  topSeriesId      Int
  countryName      String
  championTeamId   Int
  championTeamName String
  championUserId   Int?
  championUserName String?
  played           Int
  points           Int
  complete         Boolean @default(false)

  league NationalLeague @relation(fields: [leagueId], references: [leagueId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([leagueId, season])
  @@index([season])
  @@index([championTeamId])
  @@index([championUserId])
}

/// A national-level cup (worlddetails CupLeagueLevel 0). Five per country: one MAIN national cup
/// (cupLevel 1) and four SECONDARY/consolation cups (cupLevel 2 or 3). Per-serie lower-division
/// cups (CupLeagueLevel > 0) are intentionally excluded. Seeded from worlddetails.
model Cup {
  cupId         Int     @id
  leagueId      Int
  countryName   String
  cupName       String
  cupLevel      Int // 1 = main national cup; 2/3 = secondary/consolation
  cupLevelIndex Int
  isMain        Boolean // cupLevel == 1
  currentSeason Int?

  champions CupChampion[]

  @@index([leagueId])
}

/// Winner of one cup for one season, reconstructed from `cupmatches` (the final match — the team
/// with more goals wins; a level final is decided on penalties, flagged by `penalties`). Team ids
/// come from `matchdetails` on the final. championUserId is the winning team's owner AT that season
/// (ownership history), same attribution model as LeagueChampion — null until resolved.
model CupChampion {
  cupId            Int
  season           Int
  leagueId         Int
  countryName      String
  cupName          String
  isMain           Boolean
  finalMatchId     Int
  championTeamId   Int? // resolved from matchdetails in a second pass (winner is positional)
  championTeamName String
  /// The winning TEAM's own country (its league id) — not `leagueId` above, which is the COMPETITION's
  /// country and is the sentinel 0 for the international cups (Masters, Seasonal). Only those need it:
  /// a national cup's winner is by definition from that cup's country. Resolved from teamdetails
  /// (see sync/intlTeamCountries.ts); 0 is the "tried, unresolvable" sentinel, null = never tried.
  championLeagueId Int?
  runnerUpTeamName String
  homeGoals        Int
  awayGoals        Int
  penalties        Boolean @default(false)
  championUserId   Int?
  championUserName String?

  cup Cup @relation(fields: [cupId], references: [cupId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([cupId, season])
  @@index([season])
  @@index([championTeamId])
  @@index([championUserId])
  @@index([leagueId])
}

/// A Hattrick World Cup edition (senior or youth) — international, one champion NATION per
/// edition, not a manager/club. No CHPP path exists (cupmatches(137,*) returns nothing for
/// national-team competitions, unlike club cups) — scraped once from the single roll-of-honour
/// table at World/WorldCup/History.aspx (see sync/worldCup.ts). The youth bracket was called
/// "U20" through edition 31 and "U21" from edition 32 on; ageGroup keeps the exact label shown.
model WorldCupChampion {
  isYouth      Boolean
  edition      Int
  ageGroup     String? // "U20" | "U21", set only when isYouth
  host         String
  finishedDate String? // "DD.MM.YYYY", null while the edition is still ongoing
  champion     String? // nation name, null while ongoing
  runnerUp     String?
  thirdFourth  String  @default("") // 0-2 nation names, comma-separated (SQLite has no array type)
  /// The manager coaching the champion nation's team when the edition finished — cross-referenced
  /// from NTFormerCoaches.aspx (per-team coaching-tenure history, scraped) against `finishedDate`.
  /// Null when unattributed: "Retired user" tenure, no tenure recorded that early, or the nation's
  /// team id never resolved (see sync/worldCup.ts).
  championUserId   Int?
  championUserName String?
  /// The rest of the podium's coaches, resolved by the same rule. Unlike the regional cups (whose
  /// scrape captured podium team ids), these nations are known by NAME only — History.aspx never
  /// linked them — so the team id comes from national-team-ids.json. Ids only; names and
  /// nationalities are looked up from HattrickUser at bake time.
  runnerUpUserId     Int?
  /// Comma-separated, index-aligned with `thirdFourth`. An empty slot = unattributable.
  thirdFourthUserIds String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([isYouth, edition])
}

/// One season of a REGIONAL national-team cup — Africa / America / Asia and Oceania / Europe /
/// Nations Cup (see sync/ntCups.ts for the registry). Same nature as WorldCupChampion (a champion
/// NATION, no CHPP path) but a different page shape: each cup is perpetual with one champion per
/// SEASON, read from World/WorldCup/Cup.aspx?cupId=X&season=N — which is why this is keyed
/// (cupId, season) rather than by edition number.
///
/// The World Cup itself is deliberately NOT stored here: it keeps its History.aspx roll of honour
/// in WorldCupChampion, so a title can never be counted twice. isYouth is carried per row (fed
/// from the registry) so the U21 cup ids can be added without a migration — it selects which team
/// entity coach attribution resolves against (nationalTeamId vs u20TeamId).
model NationalCupChampion {
  cupId   Int
  season  Int
  cupName String
  isYouth Boolean @default(false)
  host    String  @default("")
  /// "DD-MM-YYYY" as printed on the page (NB: hyphens here, unlike WorldCupChampion's dots) — the
  /// final's date, and the instant coach attribution is measured at. Null while a season is running.
  finalDate   String?
  startedDate String?
  status      String? // "Finished" | "Ongoing" | … as printed
  champion    String? // nation name, null until the final is played
  runnerUp    String?
  thirdFourth String  @default("") // 0-2 nation names, comma-separated (SQLite has no array type)
  /// Nation team ids from the podium links — the champion's is what coach attribution keys off, so
  /// no name-matching against national-team-ids.json is needed for rows that carry it.
  championTeamId Int?
  championLeagueId Int?
  /// The rest of the podium, kept so a MEDAL table can be attributed to coaches the same way the
  /// champion is (a runner-up is not a trophy and never counts toward Trophy leaders). Null/empty
  /// on rows scraped before these were captured — the ids are the only thing a re-scrape adds.
  runnerUpTeamId   Int?
  runnerUpLeagueId Int?
  /// Comma-separated, index-aligned with `thirdFourth`: both losing semi-finalists place jointly
  /// third (Hattrick plays no third-place match), so this holds 0-2 ids.
  thirdFourthTeamIds   String @default("")
  thirdFourthLeagueIds String @default("")
  /// The manager coaching the champion nation when the final was played, same tenure cross-reference
  /// as WorldCupChampion. Null when unattributed.
  championUserId   Int?
  championUserName String?
  /// The rest of the podium's coaches, resolved the same way. Only ids are stored — names and
  /// nationalities come from HattrickUser at bake time, so a rename can't leave a stale copy here.
  /// A medal is NOT a trophy: these never reach a manager's title count.
  runnerUpUserId     Int?
  /// Comma-separated, index-aligned with `thirdFourthTeamIds` (0-2 joint-third nations). An empty
  /// slot means that nation's coach was unattributable (a deleted account, or no tenure that far back).
  thirdFourthUserIds String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([cupId, season])
  @@index([season])
  @@index([championUserId])
}

/// A country's National Coach election result for one World Cup cycle — who the community voted
/// to lead their national team, independent of whether that country ever won anything. No CHPP
/// path (same story as WorldCupChampion); scraped once per country from World/Elections/
/// History.aspx?LeagueID=X, which — unlike NTFormerCoaches — links the winner's userId directly,
/// no date-matching needed. "A former user" (no link) is the same unattributed sentinel used
/// everywhere else.
///
/// (leagueId, edition) is NOT unique: a re-election can happen within the same cycle (a coach
/// stepping down mid-term triggers a new vote for the same World Cup N), so this ingests as a
/// re-sync — clear each country's rows and reinsert — rather than a per-row upsert, or the earlier
/// winner in a repeated cycle would be silently lost.
model NationalCoachElection {
  id          Int    @id @default(autoincrement())
  leagueId    Int
  countryName String
  edition     Int // the "World Cup N" cycle this election was held for
  host        String
  /// Senior National Coach election, or the U20/U21 one — both live on the same History.aspx page,
  /// in two separate tables. Defaults false so rows scraped before the youth table was read stay
  /// senior, which is what they are.
  isYouth        Boolean @default(false)
  winnerUserId   Int?
  winnerUserName String?
  votes          String? // raw "37 (44%)" text from the page

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
  @@index([winnerUserId])
}

/// A Hattrick manager who has won at least one top-division title. Resolved from the champion
/// team's CURRENT owner (teamdetails) — historical owners aren't exposed by CHPP. nationality
/// comes from managercompendium. isBot/abandoned teams have no owner (userId stays unresolved).
model HattrickUser {
  userId      Int     @id
  loginName   String
  countryId   Int?
  nationality String? // manager's country (managercompendium)
  isBot       Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([nationality])
}

/// Per-user CHPP OAuth 1.0a access token + secret. Server-side only.
/// `userId` is Hattrick's user id (from the access-token response), not a local account.
model ChppToken {
  userId      Int      @id
  accessToken String
  tokenSecret String
  scope       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
