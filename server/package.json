{
  "name": "@hattrick-archive/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "token": "tsx src/scripts/get-token.ts",
    "refresh:latest": "tsx src/scripts/refresh-latest.ts",
    "backfill:special": "tsx src/scripts/backfill-special.ts",
    "reconstruct": "tsx src/scripts/reconstruct-from-bake.ts",
    "bake": "tsx src/scripts/bake-static.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.0",
    "oauth-1.0a": "^2.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
