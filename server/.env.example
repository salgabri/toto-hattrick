# ---- Hattrick CHPP credentials (server-side only — NEVER expose to the browser) ----
# Register a CHPP app at https://www.hattrick.org/en/community/Chpp/ to get these.
CHPP_CONSUMER_KEY=your-consumer-key
CHPP_CONSUMER_SECRET=your-consumer-secret

# OAuth 1.0a callback. Use "oob" (out-of-band) for a manual PIN flow during dev,
# or a real URL your backend handles once you wire a browser redirect.
CHPP_CALLBACK_URL=oob

# ---- Database ----
# SQLite for local dev. Path is relative to server/prisma/ (the schema dir). Swap the Prisma
# datasource to Postgres later by changing this URL only.
DATABASE_URL="file:./dev.db"

# ---- Server ----
PORT=3001
# Origin of the Vite dev server, used for CORS.
WEB_ORIGIN=http://localhost:5173

# ---- In-browser scrape (dev only, see src/routes/scrape.ts) ----
# Directory the scrape endpoints read targets from and append results to. If SCRAPE_DIR is unset,
# /api/scrape/targets returns [] and /api/scrape/results silently discards everything POSTed —
# the browser script appears to run fine and saves nothing.
# SCRAPE_DIR=C:/dev/toto-hattrick/.scrape
# Which target/result file pair the generic browser scripts use. One of:
#   (unset) league | cup | masters | generation | worldcup-coaches | elections | ntcups
# SCRAPE_PHASE=elections

# ---- Automated archive updates (optional; private and server-side) ----
# Defaults to local disk; no AWS account is needed. Relative to server/.
# Do not set UPDATE_STORE_DIR and UPDATE_STATE_BUCKET together.
# UPDATE_STORE_DIR=../.update-store
UPDATE_WORK_DIR=../.update-work
UPDATE_MAX_CALLS=600
UPDATE_MAX_ITEMS=300
UPDATE_MAX_MINUTES=40
CHPP_USER_AGENT=HattrickArchive/0.1.0
# Set true ONLY after confirming your CHPP application permits unattended XML calls.
UPDATE_CHPP_AUTOMATION_APPROVED=false
# CI uses these secrets; local runs can use OAUTH_ACCESS_STASH instead.
# CHPP_ACCESS_TOKEN=
# CHPP_ACCESS_TOKEN_SECRET=
# OAUTH_ACCESS_STASH=.oauth-access.json

# Optional hosted GitHub Actions storage: private, versioned, encrypted S3 + OIDC role.
# UPDATE_STATE_BUCKET=your-private-bucket
# UPDATE_STATE_PREFIX=hattrick-archive
# AWS_REGION=eu-central-1

# Production URL used after a GitHub merge to verify the manifest and all seven bundles.
# Git delivery uses the existing Git credentials and Vercel GitHub connection; no token is sent
# to the browser or committed. Supplying the Vercel settings also proves the exact merged commit
# is the deployment currently serving production.
UPDATE_PUBLIC_URL=https://your-existing-site.vercel.app
UPDATE_DEPLOY_PROVIDER=vercel
# Required by the weekly Git publisher to prove that production is the exact merged commit:
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# VERCEL_TOKEN=
# The following remain only for the operator-only direct-deployment recovery adapter:
# VERCEL_PROTECTION_BYPASS=
# Alternative Netlify configuration:
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
# UPDATE_PUBLIC_URL=https://your-site.netlify.app
# Optional success heartbeat. Its provider should alert if no run arrives within 36 hours.
# UPDATE_HEARTBEAT_URL=
